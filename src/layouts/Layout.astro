---
import '../styles/global.css';
import { localeHtmlLang, type Locale } from '../i18n/types';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const {
  title = 'OBJECTSCADA - Industrial control and monitoring system',
  description =
    'OBJECTSCADA is a modern web-based SCADA platform for industrial monitoring, control, and automation of technological processes. Supports Siemens S7, Modbus, MQTT, OPC UA, EtherNet/IP.',
  lang = 'en',
} = Astro.props;

const htmlLang = localeHtmlLang[lang];
const htmlDir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          var h = document.documentElement;
          if (t === 'light') h.classList.remove('dark');
          else h.classList.add('dark');
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body
    class="bg-app-canvas text-neutral-900 antialiased dark:bg-dark-900 dark:text-zinc-100 font-sans [font-feature-settings:'cv02','cv03','cv04','cv11']"
  >
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-app-canvas: #f8f9fa;
    --color-dark-900: #121212;
    --color-dark-800: #1a1a1a;
    --color-dark-700: #1e1e1e;
    --color-dark-600: #2a2a2a;
  }

  html {
    scroll-behavior: smooth;
  }

  * {
    box-sizing: border-box;
  }

  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-app-canvas);
  }

  :global(.dark) ::-webkit-scrollbar-track {
    background: var(--color-dark-900);
  }

  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  :global(.dark) ::-webkit-scrollbar-thumb {
    background: #3d3d3d;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  :global(.dark) ::-webkit-scrollbar-thumb:hover {
    background: #525252;
  }
</style>
