---
import '../styles/global.css';
import { localeHtmlLang, type Locale } from '../i18n/types';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const {
  title = 'OBJECTSCADA — web SCADA for industrial process control',
  description = 'OBJECTSCADA is a web SCADA system for monitoring and control of industrial processes. Works in the browser, connects to Siemens S7, Modbus, OPC UA, MQTT and EtherNet/IP.',
  lang = 'en',
} = Astro.props;

const htmlLang = localeHtmlLang[lang];
const htmlDir = lang === 'ar' ? 'rtl' : 'ltr';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}screens/shema_en_light.png`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={['font-sans antialiased', htmlDir === 'rtl' && '[font-family:"Noto_Sans_Arabic",Manrope,sans-serif]']}>
    <slot />
  </body>
</html>
