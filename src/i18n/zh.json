        "badge": "普遍的"
      },
      {
        "name": "MQTT",
        "subtitle": "经纪商/客户",
        "description": "物联网设备协议。订阅主题，发布命令。与 Mosquitto、HiveMQ、AWS IoT Core 兼容。服务质量 0/1/2。",
        "badge": "物联网"
      },
      {
        "name": "OPC统一协议",
        "subtitle": "客户端/服务器",
        "description": "行业标准 IIoT。与任何 OPC UA 兼容设备进行安全数据交换。支持节点ID、浏览、订阅。",
        "badge": "工业物联网"
      },
      {
        "name": "以太网/IP",
        "subtitle": "艾伦-布拉德利/罗克韦尔",
