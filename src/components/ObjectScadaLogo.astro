---
interface Props {
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
const base = import.meta.env.BASE_URL;
const markClass = size === 'header' ? 'h-9 w-9' : 'h-8 w-8';
const textClass = size === 'header' ? 'text-[1.0625rem]' : 'text-base';
---

<span class="inline-flex items-center gap-2.5" dir="ltr">
  <span class:list={['relative shrink-0', markClass]} aria-hidden="true">
    <img src={`${base}logo-mark.svg`} alt="" class="shot-light h-full w-full" draggable="false" />
    <img src={`${base}logo-mark-dark.svg`} alt="" class="shot-dark h-full w-full" draggable="false" />
  </span>
  <span class:list={['leading-none tracking-[0.02em] text-ink', textClass]}>
    <span class="font-normal">OBJECT</span><span class="font-extrabold">SCADA</span>
  </span>
</span>
