---
import type { Locale } from '../i18n/types';
import type { Messages } from '../i18n/types';
import { anchorHref } from '../i18n/utils';

interface Props {
  lang: Locale;
  m: Messages;
}

const { lang, m } = Astro.props;
const h = m.hero;
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20"
>
  <div class="absolute inset-0 bg-app-canvas dark:bg-dark-900"></div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_85%_55%_at_50%_-12%,rgba(217,119,6,0.09)_0%,transparent_55%)] dark:bg-[radial-gradient(ellipse_85%_50%_at_50%_-10%,rgba(245,158,11,0.12)_0%,transparent_52%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(120,113,108,0.07)_0%,transparent_48%)] dark:bg-[radial-gradient(ellipse_at_bottom_right,rgba(245,158,11,0.05)_0%,transparent_48%)]"
  >
  </div>

  <div class="absolute inset-0 opacity-40 dark:opacity-[0.14]">
    <div
      class="absolute inset-0 [background-image:linear-gradient(rgba(15,23,42,0.055)_1px,transparent_1px),linear-gradient(90deg,rgba(15,23,42,0.055)_1px,transparent_1px)] [background-size:48px_48px] dark:[background-image:linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.04)_1px,transparent_1px)]"
    >
    </div>
  </div>

  <div
    class="absolute top-1/4 -left-16 sm:-left-32 w-64 sm:w-96 h-64 sm:h-96 rounded-full bg-amber-400/14 blur-3xl pointer-events-none dark:bg-amber-600/10"
  >
  </div>
  <div
    class="absolute bottom-1/4 -right-16 sm:-right-32 w-64 sm:w-96 h-64 sm:h-96 rounded-full bg-stone-400/12 blur-3xl pointer-events-none dark:bg-stone-600/8"
  >
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-[5] h-44 bg-gradient-to-t from-[rgba(15,23,42,0.06)] to-transparent dark:from-black/30"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div
      class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50/90 px-4 py-1.5 mb-8 backdrop-blur-sm dark:border-amber-800/50 dark:bg-amber-950/60"
    >
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse dark:bg-amber-400"></span>
      <span class="text-sm font-medium text-amber-900 dark:text-amber-200">{h.badge}</span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold leading-tight tracking-tight mb-6">
      <span class="text-neutral-900 dark:text-zinc-50">{h.h1a}</span><br />
      <span
        class="bg-gradient-to-r from-amber-500 via-amber-400 to-orange-400 bg-clip-text text-transparent"
      >
        {h.h1b}
      </span>
    </h1>

    <p
      class="text-neutral-600 dark:text-zinc-400 text-lg sm:text-xl lg:text-2xl max-w-3xl mx-auto mb-10 leading-relaxed"
    >
      {h.sub}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 px-2 sm:px-0">
      <a
        href={anchorHref(lang, '#contact')}
        class="w-full sm:w-auto bg-neutral-900 hover:bg-neutral-800 text-white font-semibold px-8 py-4 rounded-xl transition-all duration-200 shadow-xl shadow-neutral-900/25 hover:shadow-amber-500/20 hover:-translate-y-0.5 text-base dark:bg-zinc-100 dark:text-neutral-900 dark:hover:bg-white dark:shadow-zinc-100/25"
      >
        {h.ctaDemo}
      </a>
      <a
        href={anchorHref(lang, '#features')}
        class="w-full sm:w-auto border border-app-line-strong hover:border-amber-500/70 text-neutral-800 hover:text-neutral-950 dark:border-dark-600 dark:text-zinc-300 dark:hover:text-zinc-50 font-semibold px-8 py-4 rounded-xl transition-all duration-200 text-base flex items-center justify-center gap-2 group"
      >
        {h.ctaMore}
        <svg
          class="w-4 h-4 group-hover:translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 max-w-3xl mx-auto mb-16">
      {
        h.stats.map((stat) => (
          <div
            class="rounded-xl border border-app-line bg-app-panel/95 p-5 shadow-sm backdrop-blur-sm dark:border-dark-600 dark:bg-dark-700"
          >
            <div class="text-2xl sm:text-3xl font-bold text-amber-700 dark:text-amber-400 mb-1">
              {stat.value}
            </div>
            <div class="text-neutral-500 text-sm dark:text-zinc-500">{stat.label}</div>
          </div>
        ))
      }
    </div>

    <div class="relative max-w-5xl mx-auto">
      <div
        class="rounded-2xl border border-app-line/90 bg-app-panel p-1 shadow-lg shadow-slate-300/25 backdrop-blur-sm dark:border-dark-600 dark:bg-dark-700 dark:shadow-black/40"
      >
        <div
          class="rounded-xl bg-app-canvas px-4 py-3 flex items-center gap-3 mb-1 dark:bg-dark-800"
        >
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
          </div>
          <div
            class="flex-1 rounded-md border border-app-line bg-white px-3 py-1 text-neutral-600 text-xs font-mono truncate dark:border-dark-600 dark:bg-dark-900 dark:text-zinc-500"
          >
            {h.mockup.browserUrl}
          </div>
        </div>
        <div class="rounded-xl overflow-hidden">
          <img
            src={`${import.meta.env.BASE_URL}interface-light.png`}
            alt="OBJECTSCADA Dashboard"
            class="w-full block dark:hidden"
            loading="eager"
          />
          <img
            src={`${import.meta.env.BASE_URL}interface-dark.png`}
            alt="OBJECTSCADA Dashboard"
            class="w-full hidden dark:block"
            loading="eager"
          />
        </div>
      </div>
      <div
        class="absolute -bottom-8 left-1/2 -translate-x-1/2 w-3/4 h-16 bg-amber-500/15 blur-2xl rounded-full dark:bg-amber-500/10"
      >
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
    <span class="text-neutral-500 text-xs dark:text-zinc-600">{h.scroll}</span>
    <svg
      class="w-5 h-5 text-neutral-500 dark:text-zinc-600"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </div>
</section>
