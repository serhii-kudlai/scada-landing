---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const sec = m.integrations;

const protocolMeta = [
  {
    color: 'slate',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#404040" opacity="0.18"/>
      <text x="8" y="32" font-family="Inter" font-weight="800" font-size="16" fill="#525252">S7</text>
    </svg>`,
  },
  {
    color: 'orange',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#ea580c" opacity="0.2"/>
      <text x="4" y="32" font-family="Inter" font-weight="800" font-size="13" fill="#fb923c">MOD</text>
    </svg>`,
  },
  {
    color: 'green',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#15803d" opacity="0.2"/>
      <text x="4" y="32" font-family="Inter" font-weight="800" font-size="12" fill="#4ade80">MQTT</text>
    </svg>`,
  },
  {
    color: 'purple',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#6b21a8" opacity="0.2"/>
      <text x="4" y="32" font-family="Inter" font-weight="800" font-size="11" fill="#c084fc">OPC</text>
    </svg>`,
  },
  {
    color: 'red',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#991b1b" opacity="0.2"/>
      <text x="8" y="32" font-family="Inter" font-weight="800" font-size="14" fill="#f87171">EIP</text>
    </svg>`,
  },
];

const colorMap: Record<string, { border: string; glow: string; badge: string }> = {
  slate: { border: 'border-app-line dark:border-zinc-600/55',   glow: 'hover:border-neutral-400/75 dark:hover:border-zinc-500/55',   badge: 'bg-neutral-200 text-neutral-900 dark:bg-zinc-800/70 dark:text-zinc-200' },
  orange: { border: 'border-app-line dark:border-orange-900/45', glow: 'hover:border-orange-400/70 dark:hover:border-orange-500/55', badge: 'bg-orange-100 text-orange-800 dark:bg-orange-950/55 dark:text-orange-300' },
  green:  { border: 'border-app-line dark:border-green-900/45',  glow: 'hover:border-green-400/70 dark:hover:border-green-500/55',  badge: 'bg-green-100 text-green-800 dark:bg-green-950/55 dark:text-green-300' },
  purple: { border: 'border-app-line dark:border-purple-900/45', glow: 'hover:border-purple-400/70 dark:hover:border-purple-500/55', badge: 'bg-purple-100 text-purple-800 dark:bg-purple-950/55 dark:text-purple-300' },
  red:    { border: 'border-app-line dark:border-red-900/45',    glow: 'hover:border-red-400/70 dark:hover:border-red-500/55',    badge: 'bg-red-100 text-red-800 dark:bg-red-950/55 dark:text-red-300' },
};
---

<section id="integrations" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute inset-0 z-0 bg-app-canvas dark:bg-dark-900"></div>
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_90%_50%_at_50%_30%,rgba(82,82,82,0.06)_0%,transparent_72%)] opacity-50 dark:opacity-35"
  ></div>
  <div class="bg-landing-section-edges" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-amber-200/90 bg-amber-50/95 px-4 py-1.5 mb-6 dark:border-amber-800/45 dark:bg-amber-950/40"
      >
        <span class="text-sm font-medium text-amber-900 dark:text-amber-200/90">{sec.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 dark:text-zinc-50 mb-5">
        {sec.h2a}<br />
        <span class="bg-gradient-to-r from-amber-600 via-orange-500 to-amber-600 bg-clip-text text-transparent dark:from-amber-400 dark:via-orange-400 dark:to-amber-300">
          {sec.h2b}
        </span>
      </h2>
      <p class="text-neutral-600 dark:text-zinc-400 text-lg max-w-2xl mx-auto">
        {sec.intro}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {
        sec.protocols.map((proto, i) => {
          const meta = protocolMeta[i]!;
          const c = colorMap[meta.color]!;
          return (
            <div
              class={`group border ${c.border} ${c.glow} bg-app-panel rounded-xl p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 dark:bg-dark-700 dark:hover:bg-dark-700`}
            >
              <div class="flex items-start gap-4 mb-4">
                <div set:html={meta.icon} class="shrink-0" />
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="font-bold text-lg text-neutral-900 dark:text-zinc-50">{proto.name}</h3>
                    <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${c.badge}`}>
                      {proto.badge}
                    </span>
                  </div>
                  <p class="text-neutral-500 text-sm dark:text-zinc-500">{proto.subtitle}</p>
                </div>
              </div>
              <p class="text-neutral-600 dark:text-zinc-400 text-sm leading-relaxed">{proto.description}</p>
            </div>
          );
        })
      }
    </div>

    <div
      class="flex flex-col items-center gap-8 rounded-xl border border-app-line bg-gradient-to-r from-neutral-100/95 to-app-canvas p-8 dark:from-zinc-800/80 dark:to-dark-700 dark:border-dark-600 lg:flex-row"
    >
      <div
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-neutral-300 bg-neutral-200/80 dark:border-zinc-600 dark:bg-zinc-800/80"
      >
        <svg
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="text-neutral-600 dark:text-zinc-300"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </div>
      <div class="flex-1 text-center lg:text-left">
        <div
          class="inline-flex items-center gap-1.5 bg-amber-100 text-amber-900 dark:bg-amber-950/50 dark:text-amber-200 text-xs px-2.5 py-1 rounded-full mb-3"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          {sec.tia.badge}
        </div>
        <h3 class="mb-2 text-xl font-bold text-neutral-900 dark:text-zinc-50">{sec.tia.title}</h3>
        <p class="max-w-2xl leading-relaxed text-neutral-600 dark:text-zinc-400">
          {sec.tia.body}
        </p>
      </div>
      <div class="shrink-0">
        <span
          class="inline-block bg-neutral-200 border border-neutral-300 text-neutral-800 dark:bg-zinc-800/80 dark:border-zinc-600 dark:text-zinc-200 text-sm font-semibold px-5 py-2.5 rounded-lg"
        >
          {sec.tia.pill}
        </span>
      </div>
    </div>
  </div>
</section>
