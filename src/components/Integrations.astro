---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const sec = m.integrations;

const protocolMeta = [
  {
    color: 'blue',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#1e40af" opacity="0.2"/>
      <text x="8" y="32" font-family="Inter" font-weight="800" font-size="16" fill="#60a5fa">S7</text>
    </svg>`,
  },
  {
    color: 'orange',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#ea580c" opacity="0.2"/>
      <text x="4" y="32" font-family="Inter" font-weight="800" font-size="13" fill="#fb923c">MOD</text>
    </svg>`,
  },
  {
    color: 'green',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#15803d" opacity="0.2"/>
      <text x="4" y="32" font-family="Inter" font-weight="800" font-size="12" fill="#4ade80">MQTT</text>
    </svg>`,
  },
  {
    color: 'purple',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#6b21a8" opacity="0.2"/>
      <text x="4" y="32" font-family="Inter" font-weight="800" font-size="11" fill="#c084fc">OPC</text>
    </svg>`,
  },
  {
    color: 'red',
    icon: `<svg viewBox="0 0 48 48" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="10" fill="#991b1b" opacity="0.2"/>
      <text x="8" y="32" font-family="Inter" font-weight="800" font-size="14" fill="#f87171">EIP</text>
    </svg>`,
  },
];

const colorMap: Record<string, { border: string; glow: string; badge: string }> = {
  blue:   { border: 'border-blue-800/50',   glow: 'hover:border-blue-600/70',   badge: 'bg-blue-900/50 text-blue-300' },
  orange: { border: 'border-orange-800/50', glow: 'hover:border-orange-600/70', badge: 'bg-orange-900/50 text-orange-300' },
  green:  { border: 'border-green-800/50',  glow: 'hover:border-green-600/70',  badge: 'bg-green-900/50 text-green-300' },
  purple: { border: 'border-purple-800/50', glow: 'hover:border-purple-600/70', badge: 'bg-purple-900/50 text-purple-300' },
  red:    { border: 'border-red-800/50',    glow: 'hover:border-red-600/70',    badge: 'bg-red-900/50 text-red-300' },
};
---

<section id="integrations" class="py-24 lg:py-32 relative">
  <div class="absolute inset-0 bg-dark-900"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 bg-blue-950/60 border border-blue-800/50 rounded-full px-4 py-1.5 mb-6">
        <span class="text-blue-400 text-sm font-medium">{sec.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-5">
        {sec.h2a}<br />
        <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
          {sec.h2b}
        </span>
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        {sec.intro}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {
        sec.protocols.map((proto, i) => {
          const meta = protocolMeta[i]!;
          const c = colorMap[meta.color]!;
          return (
            <div
              class={`group bg-dark-700/40 border ${c.border} ${c.glow} rounded-2xl p-6 transition-all duration-300 hover:bg-dark-700/60 hover:-translate-y-1`}
            >
              <div class="flex items-start gap-4 mb-4">
                <div set:html={meta.icon} class="shrink-0" />
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="text-white font-bold text-lg">{proto.name}</h3>
                    <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${c.badge}`}>
                      {proto.badge}
                    </span>
                  </div>
                  <p class="text-slate-500 text-sm">{proto.subtitle}</p>
                </div>
              </div>
              <p class="text-slate-400 text-sm leading-relaxed">{proto.description}</p>
            </div>
          );
        })
      }
    </div>

    <div
      class="bg-gradient-to-r from-blue-950/60 to-dark-700/60 border border-blue-800/40 rounded-2xl p-8 flex flex-col lg:flex-row items-center gap-8"
    >
      <div class="shrink-0 w-16 h-16 rounded-2xl bg-blue-600/20 border border-blue-600/30 flex items-center justify-center">
        <svg
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#60a5fa"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </div>
      <div class="flex-1 text-center lg:text-left">
        <div
          class="inline-flex items-center gap-1.5 bg-blue-900/40 text-blue-300 text-xs px-2.5 py-1 rounded-full mb-3"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          {sec.tia.badge}
        </div>
        <h3 class="text-white font-bold text-xl mb-2">{sec.tia.title}</h3>
        <p class="text-slate-400 leading-relaxed max-w-2xl">
          {sec.tia.body}
        </p>
      </div>
      <div class="shrink-0">
        <span
          class="inline-block bg-blue-600/20 border border-blue-600/40 text-blue-300 text-sm font-semibold px-5 py-2.5 rounded-lg"
        >
          {sec.tia.pill}
        </span>
      </div>
    </div>
  </div>
</section>
