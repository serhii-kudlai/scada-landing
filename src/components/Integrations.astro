---
import type { Messages } from '../i18n/types';
import SectionHead from './SectionHead.astro';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const p = m.protocols;
---

<section id="protocols" class="scroll-mt-16 border-b border-line py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHead kicker={p.kicker} title={p.h2} intro={p.intro} />

    <div class="grid gap-8 lg:grid-cols-12">
      <ul class="overflow-hidden rounded border border-line bg-paper lg:col-span-7">
        {
          p.items.map((item) => (
            <li class="grid gap-1 border-b border-line px-5 py-5 last:border-b-0 sm:grid-cols-[11rem_1fr] sm:gap-6 sm:px-6">
              <span class="font-bold text-ink">{item.name}</span>
              <span class="text-[15px] leading-relaxed text-muted">{item.detail}</span>
            </li>
          ))
        }
      </ul>

      <aside class="card-strip flex flex-col rounded border border-line bg-paper p-6 sm:p-8 lg:col-span-5">
        <p class="kicker mb-4">{p.plc.kicker}</p>
        <h3 class="text-2xl font-extrabold leading-tight text-ink">{p.plc.title}</h3>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">{p.plc.body}</p>
        <ul class="mt-6 space-y-3 border-t border-line pt-6">
          {
            p.plc.points.map((point) => (
              <li class="flex gap-3 text-[15px] leading-relaxed text-ink">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true" />
                {point}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>
