---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const c = m.cta;

const benefitIcons = [
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
];
---

<section id="contact" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-slate-100 dark:bg-dark-800/50"></div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_#93c5fd_0%,_transparent_65%)] opacity-40 dark:bg-[radial-gradient(ellipse_at_center,_#1e3a8a_0%,_transparent_65%)] dark:opacity-30"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div class="flex flex-col justify-center">
        <div
          class="mb-6 inline-flex w-fit items-center gap-2 rounded-full border border-blue-200 bg-blue-50/90 px-4 py-1.5 dark:border-blue-800/50 dark:bg-blue-950/60"
        >
          <span class="text-sm font-medium text-blue-700 dark:text-blue-400">{c.badge}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-6">
          {c.h2a}<br />
          <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
            {c.h2b}
          </span>
        </h2>

        <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed mb-10">
          {c.intro}
        </p>

        <div class="space-y-5">
          {
            c.benefits.map((item, i) => (
              <div class="flex items-start gap-4">
                <div class="shrink-0 w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-600/30 flex items-center justify-center text-blue-400">
                  <span set:html={benefitIcons[i] ?? benefitIcons[0]!} />
                </div>
                <div>
                  <div class="font-semibold text-sm mb-0.5 text-slate-900 dark:text-white">{item.title}</div>
                  <div class="text-slate-600 dark:text-slate-400 text-sm">{item.desc}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl dark:border-slate-700/50 dark:bg-dark-700/60 dark:shadow-2xl"
      >
        <h3 class="mb-6 text-xl font-bold text-slate-900 dark:text-white">{c.formTitle}</h3>
        <form id="contact-form" class="space-y-5" novalidate data-sending={c.sending} data-success={c.success}>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-400">
                {c.fields.name} <span class="text-blue-400">{c.required}</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder={c.placeholders.name}
                class="w-full rounded-lg border border-slate-300 bg-white text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-blue-500 dark:border-slate-700/60 dark:bg-dark-800 dark:text-white dark:placeholder:text-slate-600 px-4 py-3"
              />
            </div>
            <div>
              <label for="company" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-400">
                {c.fields.company} <span class="text-blue-400">{c.required}</span>
              </label>
              <input
                type="text"
                id="company"
                name="company"
                required
                placeholder={c.placeholders.company}
                class="w-full rounded-lg border border-slate-300 bg-white text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-blue-500 dark:border-slate-700/60 dark:bg-dark-800 dark:text-white dark:placeholder:text-slate-600 px-4 py-3"
              />
            </div>
          </div>

          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-400">
              {c.fields.email} <span class="text-blue-400">{c.required}</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={c.placeholders.email}
              class="w-full rounded-lg border border-slate-300 bg-white text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-blue-500 dark:border-slate-700/60 dark:bg-dark-800 dark:text-white dark:placeholder:text-slate-600 px-4 py-3"
            />
          </div>

          <div>
            <label for="phone" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-400">
              {c.fields.phone}
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder={c.placeholders.phone}
              class="w-full rounded-lg border border-slate-300 bg-white text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-blue-500 dark:border-slate-700/60 dark:bg-dark-800 dark:text-white dark:placeholder:text-slate-600 px-4 py-3"
            />
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-400">
              {c.fields.message}
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder={c.placeholders.message}
              class="w-full resize-none rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-blue-500 dark:border-slate-700/60 dark:bg-dark-800 dark:text-white dark:placeholder:text-slate-600"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit"
            data-default-label={c.submit}
            class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-blue-600/30 hover:shadow-blue-500/40 flex items-center justify-center gap-2 group"
          >
            <span class="submit-label">{c.submit}</span>
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform submit-icon"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>

          <div
            id="form-success"
            class="hidden text-center py-3 px-4 bg-green-900/30 border border-green-700/40 rounded-lg text-green-400 text-sm"
          >
          </div>

          <p class="text-center text-xs text-slate-500 dark:text-slate-600">
            {c.consent}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successEl = document.getElementById('form-success')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const btn = document.getElementById('contact-submit') as HTMLButtonElement;
    const label = btn?.querySelector('.submit-label');
    const icon = btn?.querySelector('.submit-icon');
    const sending = form.dataset.sending || '…';
    const successText = form.dataset.success || '';
    const defaultLabel = btn.dataset.defaultLabel || '';

    btn.disabled = true;
    if (label) label.textContent = sending;
    if (icon) icon.classList.add('hidden');
    successEl.classList.add('hidden');
    successEl.textContent = '';

    const data = {
      name: (form.elements.namedItem('name') as HTMLInputElement)?.value.trim(),
      company: (form.elements.namedItem('company') as HTMLInputElement)?.value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement)?.value.trim(),
      phone: (form.elements.namedItem('phone') as HTMLInputElement)?.value.trim(),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement)?.value.trim(),
    };

    try {
      const res = await fetch('/api/contact/send/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.reset();
        successEl.textContent = successText;
        successEl.className =
          'text-center py-3 px-4 bg-green-900/30 border border-green-700/40 rounded-lg text-green-400 text-sm';
      } else {
        const json = await res.json().catch(() => ({}));
        const msg = (json as { error?: string }).error || 'Ошибка отправки. Попробуйте позже.';
        successEl.textContent = msg;
        successEl.className =
          'text-center py-3 px-4 bg-red-900/30 border border-red-700/40 rounded-lg text-red-400 text-sm';
      }
    } catch {
      successEl.textContent = 'Нет соединения с сервером. Попробуйте позже.';
      successEl.className =
        'text-center py-3 px-4 bg-red-900/30 border border-red-700/40 rounded-lg text-red-400 text-sm';
    } finally {
      btn.disabled = false;
      if (label) label.textContent = defaultLabel;
      if (icon) icon.classList.remove('hidden');
    }
  });
</script>
