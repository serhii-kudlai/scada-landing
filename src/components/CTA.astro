---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const c = m.cta;
/** Set PUBLIC_CONTACT_API env var to enable form submission from static hosts (e.g. GitHub Pages).
 *  When empty the form falls back to the nginx-proxied /api/contact/send/ (Docker). */
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API || '/api/contact/send/';

const inputClass =
  'w-full rounded border border-line bg-bg px-4 py-3 text-[15px] text-ink outline-none transition-colors placeholder:text-muted/70 focus:border-ink';
const labelClass = 'mb-1.5 block text-sm font-semibold text-ink';
---

<section id="contact" class="scroll-mt-16 py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16 lg:px-8">
    <div class="lg:col-span-5">
      <p class="kicker mb-4">{c.kicker}</p>
      <h2 class="text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl">{c.h2}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">{c.intro}</p>

      <ul class="mt-10 border-t border-line">
        {
          c.benefits.map((item) => (
            <li class="border-b border-line py-5">
              <div class="font-bold text-ink">{item.title}</div>
              <div class="mt-1 text-[15px] leading-relaxed text-muted">{item.desc}</div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card-strip rounded border border-line bg-paper p-6 sm:p-8 lg:col-span-7">
      <h3 class="mb-6 text-xl font-bold text-ink">{c.formTitle}</h3>
      <form
        id="contact-form"
        class="space-y-5"
        novalidate
        data-sending={c.sending}
        data-success={c.success}
        data-error={c.errorSend}
        data-error-network={c.errorNetwork}
        data-api={contactApiUrl}
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClass}>{c.fields.name} <span class="text-accent">{c.required}</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder={c.placeholders.name} class={inputClass} />
          </div>
          <div>
            <label for="company" class={labelClass}>{c.fields.company} <span class="text-accent">{c.required}</span></label>
            <input type="text" id="company" name="company" required autocomplete="organization" placeholder={c.placeholders.company} class={inputClass} />
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="email" class={labelClass}>{c.fields.email} <span class="text-accent">{c.required}</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder={c.placeholders.email} class={inputClass} />
          </div>
          <div>
            <label for="phone" class={labelClass}>{c.fields.phone}</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder={c.placeholders.phone} class={inputClass} />
          </div>
        </div>
        <div>
          <label for="message" class={labelClass}>{c.fields.message}</label>
          <textarea id="message" name="message" rows="4" placeholder={c.placeholders.message} class:list={[inputClass, 'resize-none']}></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          data-default-label={c.submit}
          class="inline-flex h-12 w-full items-center justify-center rounded bg-ink px-6 text-[15px] font-semibold text-bg transition-opacity hover:opacity-85 disabled:opacity-60"
        >
          <span class="submit-label">{c.submit}</span>
        </button>

        <div id="form-status" class="hidden rounded border px-4 py-3 text-sm" role="status"></div>

        <p class="text-xs text-muted">{c.consent}</p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status')!;

  const showStatus = (msg: string, ok: boolean) => {
    statusEl.textContent = msg;
    statusEl.className = `rounded border px-4 py-3 text-sm ${ok ? 'border-ok text-ok' : 'border-alarm text-alarm'}`;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const btn = document.getElementById('contact-submit') as HTMLButtonElement;
    const label = btn.querySelector('.submit-label');
    const d = form.dataset;

    btn.disabled = true;
    if (label) label.textContent = d.sending || '…';
    statusEl.classList.add('hidden');

    const field = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim();
    const data = {
      name: field('name'),
      company: field('company'),
      email: field('email'),
      phone: field('phone'),
      message: field('message'),
    };

    try {
      const res = await fetch(d.api || '/api/contact/send/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.reset();
        showStatus(d.success || '', true);
      } else {
        const json = await res.json().catch(() => ({}));
        showStatus((json as { error?: string }).error || d.error || '', false);
      }
    } catch {
      showStatus(d.errorNetwork || '', false);
    } finally {
      btn.disabled = false;
      if (label) label.textContent = btn.dataset.defaultLabel || '';
    }
  });
</script>
