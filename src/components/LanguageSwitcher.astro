---
import type { Locale, Messages } from '../i18n/types';
import { homeHref } from '../i18n/utils';

interface Props {
  lang: Locale;
  m: Messages;
  /** Уникальный префикс для id (в хедере два экземпляра) */
  id: string;
}

const { lang, m, id } = Astro.props;

const entries: { code: Locale; label: string }[] = [
  { code: 'ru', label: m.lang.ru },
  { code: 'en', label: m.lang.en },
  { code: 'de', label: m.lang.de },
  { code: 'uk', label: m.lang.uk },
  { code: 'es', label: m.lang.es },
  { code: 'fr', label: m.lang.fr },
  { code: 'ar', label: m.lang.ar },
  { code: 'zh', label: m.lang.zh },
];

const labelId = `${id}-label`;
const listId = `${id}-list`;
const current = entries.find((e) => e.code === lang) ?? entries[0]!;
---

<div class="relative inline-flex shrink-0 flex-col items-stretch" data-lang-dropdown data-open="false">
  <span id={labelId} class="sr-only">{m.lang.label}</span>
  <button
    type="button"
    class="lang-dd-trigger inline-flex h-9 items-center gap-1 rounded border border-line bg-paper px-2.5 font-mono text-[11px] font-medium leading-none text-ink transition-colors hover:border-line-strong focus-visible:outline-2 focus-visible:outline-accent [&[aria-expanded='true']_svg]:rotate-180"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls={listId}
    aria-labelledby={labelId}
    data-lang-dd-toggle
  >
    <span class="min-w-[1.5rem] text-center">{current.label}</span>
    <svg
      class="h-3 w-3 shrink-0 text-muted transition-transform duration-200"
      aria-hidden="true"
      fill="none"
      viewBox="0 0 20 20"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M6 8l4 4 4-4"></path>
    </svg>
  </button>
  <div
    id={listId}
    data-lang-dd-panel
    class="lang-dd-panel pointer-events-none invisible absolute left-0 top-full z-[70] mt-1 w-full min-w-0 origin-top scale-95 opacity-0 transition-[opacity,transform,visibility] duration-150 ease-out"
    role="region"
    aria-label={m.lang.label}
  >
    <div
      class="w-full overflow-hidden rounded border border-line bg-paper py-0.5 shadow-lg"
    >
      <ul class="flex w-full flex-col gap-px px-px">
        {
          entries.map(({ code, label }) => {
            const href = homeHref(code);
            const active = lang === code;
            return (
              <li>
                <a
                  href={href}
                  hreflang={code}
                  class:list={[
                    'flex w-full items-center justify-center rounded-sm px-1.5 py-1.5 font-mono text-[11px] leading-none transition-colors',
                    active
                      ? 'bg-ink text-bg'
                      : 'text-ink hover:bg-sunken',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    if (window.__langDdInit) return;
    window.__langDdInit = true;

    function closePanel(panel) {
      var wrap = panel.closest('[data-lang-dropdown]');
      if (!wrap) return;
      var btn = wrap.querySelector('[data-lang-dd-toggle]');
      wrap.setAttribute('data-open', 'false');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      panel.classList.add('pointer-events-none', 'invisible', 'opacity-0', 'scale-95');
      panel.classList.remove('pointer-events-auto', 'visible', 'opacity-100', 'scale-100');
    }

    function openPanel(panel) {
      document.querySelectorAll('[data-lang-dropdown][data-open="true"]').forEach(function (w) {
        if (w.contains(panel)) return;
        var p = w.querySelector('[data-lang-dd-panel]');
        if (p) closePanel(p);
      });
      var wrap = panel.closest('[data-lang-dropdown]');
      if (!wrap) return;
      var btn = wrap.querySelector('[data-lang-dd-toggle]');
      wrap.setAttribute('data-open', 'true');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      panel.classList.remove('pointer-events-none', 'invisible', 'opacity-0', 'scale-95');
      panel.classList.add('pointer-events-auto', 'visible', 'opacity-100', 'scale-100');
    }

    function closeAll() {
      document.querySelectorAll('[data-lang-dd-panel]').forEach(closePanel);
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var toggle = t.closest('[data-lang-dd-toggle]');
      if (toggle) {
        e.preventDefault();
        var wrap = toggle.closest('[data-lang-dropdown]');
        var panel = wrap && wrap.querySelector('[data-lang-dd-panel]');
        if (!panel) return;
        var isOpen = wrap.getAttribute('data-open') === 'true';
        if (isOpen) closePanel(panel);
        else openPanel(panel);
        return;
      }
      if (t.closest('[data-lang-dropdown]')) return;
      closeAll();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll();
    });
  })();
</script>
