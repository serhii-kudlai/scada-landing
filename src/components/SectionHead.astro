---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
}

const { kicker, title, intro } = Astro.props;
---

<div class="mb-12 grid gap-6 lg:mb-14 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-7">
    <p class="kicker mb-4">{kicker}</p>
    <h2 class="text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl">{title}</h2>
  </div>
  {intro && <p class="text-base leading-relaxed text-muted lg:col-span-5 lg:text-lg">{intro}</p>}
</div>
