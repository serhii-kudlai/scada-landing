---
import type { Locale, Messages } from '../i18n/types';
import { screenSrc } from '../i18n/utils';
import SectionHead from './SectionHead.astro';

interface Props {
  m: Messages;
  lang: Locale;
}

const { m, lang } = Astro.props;
const s = m.screens;
---

<section id="interface" class="scroll-mt-16 border-b border-line bg-sunken py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHead kicker={s.kicker} title={s.h2} intro={s.intro} />

    <div class="grid gap-6 lg:grid-cols-12" data-screens>
      <div
        class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:px-0 lg:col-span-4 lg:mx-0 lg:flex-col lg:gap-0 lg:overflow-visible lg:px-0 lg:pb-0"
        role="tablist"
        aria-label={s.h2}
      >
        {
          s.items.map((item, i) => (
            <button
              type="button"
              role="tab"
              id={`screen-tab-${item.id}`}
              aria-controls={`screen-panel-${item.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-screen-tab={item.id}
              class="group shrink-0 rounded border border-line bg-paper px-4 py-3 text-start transition-colors aria-selected:border-ink lg:rounded-none lg:border-x-0 lg:border-t-0 lg:bg-transparent lg:px-0 lg:py-5 lg:aria-selected:border-line"
            >
              <span class="flex items-baseline gap-3">
                <span class="font-mono text-xs text-muted group-aria-selected:text-accent">{String(i + 1).padStart(2, '0')}</span>
                <span class="whitespace-nowrap text-[15px] font-bold text-muted group-aria-selected:text-ink lg:whitespace-normal lg:text-lg">
                  {item.title}
                </span>
              </span>
              <span class="mt-2 hidden ps-8 text-sm leading-relaxed text-muted lg:group-aria-selected:block">
                {item.description}
              </span>
            </button>
          ))
        }
      </div>

      <div class="lg:col-span-8">
        {
          s.items.map((item, i) => {
            const src = screenSrc(item.id, lang);
            return (
              <figure
                role="tabpanel"
                id={`screen-panel-${item.id}`}
                aria-labelledby={`screen-tab-${item.id}`}
                data-screen-panel={item.id}
                class:list={['overflow-hidden rounded border border-line bg-paper', i !== 0 && 'hidden']}
              >
                <a href={src.light} target="_blank" rel="noopener" class="shot-light" aria-label={s.open}>
                  <img src={src.light} alt={item.title} width="1600" height="1000" class="block w-full" loading="lazy" />
                </a>
                <a href={src.dark} target="_blank" rel="noopener" class="shot-dark" aria-label={s.open}>
                  <img src={src.dark} alt={item.title} width="1600" height="1000" class="block w-full" loading="lazy" />
                </a>
                <figcaption class="border-t border-line px-4 py-3 text-sm leading-relaxed text-muted lg:hidden">
                  {item.description}
                </figcaption>
              </figure>
            );
          })
        }
        <p class="mt-3 font-mono text-xs text-muted">{s.note}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-screens]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-screen-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-screen-panel]'));

    const select = (idx: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === idx;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i]?.classList.toggle('hidden', !on);
      });
      if (focus) tabs[idx]?.focus();
      tabs[idx]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const next = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select((i + next + tabs.length) % tabs.length, true);
      });
    });
  }
</script>
