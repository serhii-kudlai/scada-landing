---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const a = m.ai;
---

<section id="ai" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-app-canvas/95 dark:bg-dark-800/95"></div>
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl dark:bg-purple-900/15"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl dark:bg-blue-900/15"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-purple-50/90 px-4 py-1.5 mb-6 dark:border-purple-800/50 dark:bg-purple-950/60"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#c084fc"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M12 2a10 10 0 1 0 10 10H12V2zM22 12A10 10 0 0 0 12 2v10h10z"
            ></path>
          </svg>
          <span class="text-sm font-medium text-purple-700 dark:text-purple-400">{a.badge}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 dark:text-zinc-50 mb-6">
          {a.h2a}<br />
          <span class="bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">
            {a.h2b}
          </span>
        </h2>

        <p class="text-neutral-600 dark:text-zinc-400 text-lg leading-relaxed mb-8">
          {a.intro}
        </p>

        <ul class="space-y-3 mb-10">
          {
            a.capabilities.map((item) => (
              <li class="flex items-center gap-3">
                <div class="shrink-0 w-5 h-5 rounded-full bg-purple-600/30 border border-purple-500/40 flex items-center justify-center">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="3">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </div>
                <span class="text-neutral-700 dark:text-zinc-300 text-sm">{item}</span>
              </li>
            ))
          }
        </ul>

        <div class="flex flex-wrap gap-3">
          <div
            class="flex items-center gap-2 rounded-lg border border-app-line bg-app-panel px-3 py-2 dark:border-dark-600 dark:bg-dark-700"
          >
            <span class="text-neutral-500 dark:text-zinc-500 text-xs font-mono">FastAPI</span>
          </div>
          <div
            class="flex items-center gap-2 rounded-lg border border-app-line bg-app-panel px-3 py-2 dark:border-dark-600 dark:bg-dark-700"
          >
            <span class="text-neutral-500 dark:text-zinc-500 text-xs font-mono">Qdrant</span>
          </div>
          <div
            class="flex items-center gap-2 rounded-lg border border-app-line bg-app-panel px-3 py-2 dark:border-dark-600 dark:bg-dark-700"
          >
            <span class="text-neutral-500 dark:text-zinc-500 text-xs font-mono">RAG</span>
          </div>
          <div
            class="flex items-center gap-2 rounded-lg border border-app-line bg-app-panel px-3 py-2 dark:border-dark-600 dark:bg-dark-700"
          >
            <span class="text-neutral-500 dark:text-zinc-500 text-xs font-mono">Vector Search</span>
          </div>
        </div>
      </div>

      <div>
        <div
          class="overflow-hidden rounded-xl border border-app-line bg-app-panel shadow-lg shadow-slate-300/20 dark:border-dark-600 dark:bg-dark-700 dark:shadow-black/30"
        >
          <div
            class="flex items-center gap-3 border-b border-app-line bg-app-canvas px-4 py-3 dark:border-dark-600 dark:bg-dark-800"
          >
            <div
              class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="white"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M12 2a10 10 0 1 0 10 10H12V2zM22 12A10 10 0 0 0 12 2v10h10z"
                ></path>
              </svg>
            </div>
            <div>
              <div class="text-sm font-semibold text-neutral-900 dark:text-zinc-50">{a.chatTitle}</div>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                <span class="text-green-400 text-xs">{a.online}</span>
              </div>
            </div>
          </div>

          <div class="p-4 space-y-4 h-80 overflow-y-auto">
            {
              a.messages.map((msg) => (
                <div
                  class={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'} gap-3`}
                >
                  {msg.role === 'ai' && (
                    <div class="shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center mt-0.5">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="white">
                        <path d="M12 2a10 10 0 1 0 10 10H12V2zM22 12A10 10 0 0 0 12 2v10h10z"/>
                      </svg>
                    </div>
                  )}
                  <div
                    class={`max-w-[85%] rounded-2xl px-4 py-2.5 text-sm leading-relaxed ${
                      msg.role === 'user'
                        ? 'bg-blue-600 text-white rounded-br-sm'
                        : 'rounded-bl-sm border border-app-line bg-app-canvas text-neutral-800 dark:border-dark-600 dark:bg-dark-800 dark:text-zinc-300'
                    }`}
                  >
                    {msg.text.split('**').map((part, i) =>
                      i % 2 === 1 ? (
                        <strong class="font-semibold text-neutral-900 dark:text-zinc-50">{part}</strong>
                      ) : (
                        part
                      )
                    )}
                  </div>
                  {msg.role === 'user' && (
                    <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-neutral-200 dark:bg-zinc-600">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                      </svg>
                    </div>
                  )}
                </div>
              ))
            }
          </div>

          <div class="flex items-center gap-3 border-t border-app-line px-4 py-3 dark:border-dark-600">
            <input
              type="text"
              placeholder={a.placeholder}
              class="flex-1 rounded-lg border border-app-line bg-app-panel text-sm text-neutral-700 outline-none placeholder:text-neutral-400 focus:border-purple-500 dark:border-dark-600 dark:bg-dark-800 dark:text-zinc-400 dark:placeholder:text-zinc-600"
              disabled
            />
            <button
              class="shrink-0 w-9 h-9 rounded-lg bg-purple-600 flex items-center justify-center opacity-80"
              disabled
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
