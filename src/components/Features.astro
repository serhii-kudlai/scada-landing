---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const f = m.features;

const icons = [
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
];

const featureColors = ['emerald', 'teal', 'orange', 'green', 'purple', 'slate', 'amber', 'rose'] as const;

const colorMap: Record<string, { bg: string; border: string; icon: string; tag: string }> = {
  emerald: { bg: 'bg-app-panel dark:bg-dark-700',   border: 'border-app-line dark:border-dark-600',   icon: 'text-emerald-600 dark:text-emerald-400',   tag: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300' },
  teal:   { bg: 'bg-app-panel dark:bg-dark-700',   border: 'border-app-line dark:border-dark-600',   icon: 'text-teal-600 dark:text-teal-400',   tag: 'bg-teal-100 text-teal-800 dark:bg-teal-950/50 dark:text-teal-300' },
  orange: { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-dark-600', icon: 'text-orange-600 dark:text-orange-400', tag: 'bg-orange-100 text-orange-800 dark:bg-orange-950/50 dark:text-orange-300' },
  green:  { bg: 'bg-app-panel dark:bg-dark-700',  border: 'border-app-line dark:border-dark-600',  icon: 'text-green-600 dark:text-green-400',  tag: 'bg-green-100 text-green-800 dark:bg-green-950/50 dark:text-green-300' },
  purple: { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-dark-600', icon: 'text-purple-600 dark:text-purple-400', tag: 'bg-purple-100 text-purple-800 dark:bg-purple-950/50 dark:text-purple-300' },
  slate:  { bg: 'bg-app-panel dark:bg-dark-700',  border: 'border-app-line dark:border-dark-600',  icon: 'text-neutral-600 dark:text-zinc-400',  tag: 'bg-neutral-100 text-neutral-800 dark:bg-zinc-700/50 dark:text-zinc-300' },
  amber: { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-dark-600', icon: 'text-amber-600 dark:text-amber-400', tag: 'bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300' },
  rose:   { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-dark-600', icon: 'text-rose-600 dark:text-rose-400', tag: 'bg-rose-100 text-rose-800 dark:bg-rose-950/50 dark:text-rose-300' },
};
---

<section id="features" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute inset-0 z-0 bg-app-canvas dark:bg-dark-900"></div>
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_center,rgba(217,119,6,0.06)_0%,transparent_78%)] opacity-40 dark:bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.07)_0%,transparent_78%)] dark:opacity-32"
  >
  </div>
  <div class="bg-landing-section-edges" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-amber-200/90 bg-amber-50/95 px-4 py-1.5 mb-6 dark:border-amber-800/45 dark:bg-amber-950/40"
      >
        <span class="text-sm font-medium text-amber-900 dark:text-amber-200/90">{f.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 dark:text-zinc-50 mb-5">
        {f.h2a}<br />
        <span class="bg-gradient-to-r from-amber-600 via-orange-500 to-amber-600 bg-clip-text text-transparent dark:from-amber-400 dark:via-orange-400 dark:to-amber-300">
          {f.h2b}
        </span>
      </h2>
      <p class="text-neutral-600 dark:text-zinc-400 text-lg max-w-2xl mx-auto">
        {f.intro}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        f.items.map((feature, i) => {
          const colorKey = featureColors[i] ?? 'emerald';
          const c = colorMap[colorKey];
          const icon = icons[i] ?? icons[0]!;
          return (
            <div
              class={`group relative ${c.bg} border ${c.border} rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 cursor-default`}
            >
              <div class={`${c.icon} mb-4`} set:html={icon} />
              <h3 class="font-semibold text-base leading-snug mb-2 text-neutral-900 dark:text-zinc-50">{feature.title}</h3>
              <p class="text-neutral-600 dark:text-zinc-400 text-sm leading-relaxed mb-4">{feature.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {feature.tags.map((tag) => (
                  <span class={`${c.tag} text-xs px-2 py-0.5 rounded-full font-medium`}>{tag}</span>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
