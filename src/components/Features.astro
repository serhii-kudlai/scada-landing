---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const f = m.features;

const icons = [
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
];

const featureColors = ['blue', 'cyan', 'orange', 'green', 'purple', 'slate', 'indigo', 'teal'] as const;

const colorMap: Record<string, { bg: string; border: string; icon: string; tag: string }> = {
  blue:   { bg: 'bg-blue-50 dark:bg-blue-950/40',   border: 'border-blue-200 dark:border-blue-900/50',   icon: 'text-blue-600 dark:text-blue-400',   tag: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300' },
  cyan:   { bg: 'bg-cyan-50 dark:bg-cyan-950/40',   border: 'border-cyan-200 dark:border-cyan-900/50',   icon: 'text-cyan-600 dark:text-cyan-400',   tag: 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/40 dark:text-cyan-300' },
  orange: { bg: 'bg-orange-50 dark:bg-orange-950/40', border: 'border-orange-200 dark:border-orange-900/50', icon: 'text-orange-600 dark:text-orange-400', tag: 'bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-300' },
  green:  { bg: 'bg-green-50 dark:bg-green-950/40',  border: 'border-green-200 dark:border-green-900/50',  icon: 'text-green-600 dark:text-green-400',  tag: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300' },
  purple: { bg: 'bg-purple-50 dark:bg-purple-950/40', border: 'border-purple-200 dark:border-purple-900/50', icon: 'text-purple-600 dark:text-purple-400', tag: 'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300' },
  slate:  { bg: 'bg-slate-100 dark:bg-slate-800/40',  border: 'border-slate-300 dark:border-slate-700/50',  icon: 'text-slate-600 dark:text-slate-400',  tag: 'bg-slate-200 text-slate-800 dark:bg-slate-700/40 dark:text-slate-300' },
  indigo: { bg: 'bg-indigo-50 dark:bg-indigo-950/40', border: 'border-indigo-200 dark:border-indigo-900/50', icon: 'text-indigo-600 dark:text-indigo-400', tag: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-300' },
  teal:   { bg: 'bg-teal-50 dark:bg-teal-950/40',   border: 'border-teal-200 dark:border-teal-900/50',   icon: 'text-teal-600 dark:text-teal-400',   tag: 'bg-teal-100 text-teal-800 dark:bg-teal-900/40 dark:text-teal-300' },
};
---

<section id="features" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-slate-100/90 dark:bg-dark-800/50"></div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_#bfdbfe_0%,_transparent_70%)] opacity-40 dark:bg-[radial-gradient(ellipse_at_center,_#172554_0%,_transparent_70%)] dark:opacity-30"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/90 px-4 py-1.5 mb-6 dark:border-blue-800/50 dark:bg-blue-950/60"
      >
        <span class="text-sm font-medium text-blue-700 dark:text-blue-400">{f.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-5">
        {f.h2a}<br />
        <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
          {f.h2b}
        </span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">
        {f.intro}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        f.items.map((feature, i) => {
          const colorKey = featureColors[i] ?? 'blue';
          const c = colorMap[colorKey];
          const icon = icons[i] ?? icons[0]!;
          return (
            <div
              class={`group relative ${c.bg} border ${c.border} rounded-2xl p-6 hover:scale-[1.02] transition-all duration-300 hover:shadow-xl cursor-default`}
            >
              <div class={`${c.icon} mb-4`} set:html={icon} />
              <h3 class="font-semibold text-base leading-snug mb-2 text-slate-900 dark:text-white">{feature.title}</h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">{feature.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {feature.tags.map((tag) => (
                  <span class={`${c.tag} text-xs px-2 py-0.5 rounded-full font-medium`}>{tag}</span>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
