---
import type { Messages } from '../i18n/types';
import SectionHead from './SectionHead.astro';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const f = m.features;
---

<section id="features" class="scroll-mt-16 border-b border-line py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHead kicker={f.kicker} title={f.h2} intro={f.intro} />

    <div class="grid gap-px overflow-hidden rounded border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        f.items.map((item, i) => (
          <article class="flex flex-col bg-paper p-6 sm:p-7">
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-lg font-bold leading-snug text-ink">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
