---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const ar = m.architecture;

const layerColors = ['amber', 'slate', 'orange', 'green', 'purple', 'stone'] as const;

const colorMap: Record<string, { header: string; dot: string; border: string }> = {
  amber:  { header: 'bg-amber-100 dark:bg-amber-900/50',   dot: 'bg-amber-500 dark:bg-amber-400',   border: 'border-amber-200 dark:border-amber-800/40' },
  slate:  { header: 'bg-neutral-200 dark:bg-dark-600',  dot: 'bg-neutral-600 dark:bg-zinc-400',  border: 'border-neutral-300 dark:border-zinc-600/40' },
  teal:   { header: 'bg-teal-100 dark:bg-teal-900/50',   dot: 'bg-teal-500 dark:bg-teal-400',   border: 'border-teal-200 dark:border-teal-800/40' },
  orange: { header: 'bg-orange-100 dark:bg-orange-900/50', dot: 'bg-orange-500 dark:bg-orange-400', border: 'border-orange-200 dark:border-orange-800/40' },
  green:  { header: 'bg-green-100 dark:bg-green-900/50',  dot: 'bg-green-500 dark:bg-green-400',  border: 'border-green-200 dark:border-green-800/40' },
  purple: { header: 'bg-purple-100 dark:bg-purple-900/50', dot: 'bg-purple-500 dark:bg-purple-400', border: 'border-purple-200 dark:border-purple-800/40' },
  stone:  { header: 'bg-stone-100 dark:bg-stone-900/45', dot: 'bg-stone-500 dark:bg-stone-400', border: 'border-stone-200 dark:border-stone-700/40' },
};

/** Accent per «Интерфейс системы» block: рамка и шапка как у слоёв архитектуры */
const systemInterfaceLayerAccents = ['amber', 'slate', 'orange', 'purple'] as const;

/** Сетка мелких карточек — если у группы нет layout: layer */
const ifaceCardStyles = [
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-amber-800/45', title: 'text-amber-900 dark:text-amber-300' },
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-stone-700/45', title: 'text-stone-800 dark:text-stone-300' },
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-indigo-800/45', title: 'text-indigo-800 dark:text-indigo-300' },
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-teal-800/45', title: 'text-teal-800 dark:text-teal-300' },
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-violet-800/45', title: 'text-violet-800 dark:text-violet-300' },
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-orange-800/45', title: 'text-orange-800 dark:text-orange-300' },
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-emerald-800/45', title: 'text-emerald-800 dark:text-emerald-300' },
  { bg: 'bg-app-panel dark:bg-dark-700', border: 'border-app-line dark:border-zinc-600/45', title: 'text-zinc-800 dark:text-zinc-300' },
] as const;

const versusClassicStyle = colorMap.teal!;
---

<section id="architecture" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute inset-0 z-0 bg-app-canvas dark:bg-dark-900"></div>
  <div
    class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_bottom,rgba(217,119,6,0.06)_0%,transparent_72%)] opacity-45 dark:bg-[radial-gradient(ellipse_at_bottom,rgba(245,158,11,0.08)_0%,transparent_72%)] dark:opacity-36"
  >
  </div>
  <div class="bg-landing-section-edges" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50/90 px-4 py-1.5 mb-6 dark:border-amber-800/50 dark:bg-amber-950/60"
      >
        <span class="text-sm font-medium text-amber-900 dark:text-amber-200">{ar.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 dark:text-zinc-50 mb-5">
        {ar.h2a}<br />
        <span class="bg-gradient-to-r from-amber-500 to-orange-400 bg-clip-text text-transparent">
          {ar.h2b}
        </span>
      </h2>
      <p class="text-neutral-600 dark:text-zinc-400 text-lg max-w-2xl mx-auto">
        {ar.intro}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
      {
        ar.layers.map((layer, idx) => {
          const colorKey = layerColors[idx] ?? 'amber';
          const c = colorMap[colorKey]!;
          return (
            <div class={`overflow-hidden rounded-xl border bg-app-panel/95 dark:bg-dark-700 ${c.border}`}>
              <div class={`${c.header} px-5 py-3 flex items-center gap-2`}>
                <span class={`w-2 h-2 rounded-full ${c.dot}`} />
                <span class="text-sm font-semibold text-neutral-900 dark:text-zinc-50">{layer.label}</span>
              </div>
              <div class="p-5 space-y-3">
                {layer.items.map((item) => (
                  <div class="flex items-start gap-3">
                    <div class={`shrink-0 mt-1 w-1.5 h-1.5 rounded-full ${c.dot} opacity-60`} />
                    <div>
                      <div class="text-sm font-medium text-neutral-900 dark:text-zinc-50">{item.name}</div>
                      <div class="text-neutral-500 dark:text-zinc-500 text-xs">{item.desc}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>

    {
      ar.systemInterface && (
        <div id="system-interface" class="mb-16 scroll-mt-28 lg:scroll-mt-32">
          <div class="text-center mb-10 max-w-3xl mx-auto">
            <div
              class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50/90 px-4 py-1.5 mb-6 dark:border-amber-800/50 dark:bg-amber-950/60"
            >
              <span class="text-sm font-medium text-amber-900 dark:text-amber-200">{ar.systemInterface.badge}</span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 dark:text-zinc-50 mb-5">
              {ar.systemInterface.titleA}
              <br />
              <span class="bg-gradient-to-r from-amber-500 to-orange-400 bg-clip-text text-transparent">
                {ar.systemInterface.titleB}
              </span>
            </h2>
            <p class="text-neutral-600 dark:text-zinc-400 text-lg max-w-2xl mx-auto">{ar.systemInterface.intro}</p>
          </div>
          <div class="space-y-12">
            {ar.systemInterface.groups.map((group, groupIndex) => {
              const isLayerList = group.layout === 'layer';
              if (isLayerList) {
                const accentKey =
                  systemInterfaceLayerAccents[
                    groupIndex % systemInterfaceLayerAccents.length
                  ]!;
                const c = colorMap[accentKey]!;
                return (
                  <div
                    class={`mx-auto max-w-4xl overflow-hidden rounded-xl border bg-app-panel/95 dark:bg-dark-700 ${c.border}`}
                  >
                    <div class={`${c.header} px-5 py-3 flex items-center gap-2`}>
                      <span class={`w-2 h-2 rounded-full ${c.dot}`} />
                      <span class="text-sm font-semibold text-neutral-900 dark:text-zinc-50">{group.title}</span>
                    </div>
                    <div class="p-5 space-y-3">
                      {group.cards.map((card) => (
                        <div class="flex items-start gap-3">
                          <div class={`shrink-0 mt-1 w-1.5 h-1.5 rounded-full ${c.dot} opacity-60`} />
                          <div>
                            <div class="text-sm font-medium text-neutral-900 dark:text-zinc-50">{card.title}</div>
                            <div class="text-neutral-500 dark:text-zinc-500 text-xs leading-relaxed">{card.desc}</div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              }

              const cols =
                group.cards.length === 1
                  ? 'grid max-w-2xl mx-auto grid-cols-1'
                  : 'grid sm:grid-cols-2 lg:grid-cols-3 gap-4';
              return (
                <div>
                  <h4 class="mb-4 flex items-center gap-2 text-lg font-semibold text-neutral-900 dark:text-zinc-50">
                    <span class="w-1 h-6 rounded-full bg-gradient-to-b from-amber-500 to-orange-400" />
                    {group.title}
                  </h4>
                  <div class={cols}>
                    {group.cards.map((card, ci) => {
                      const st = ifaceCardStyles[ci % ifaceCardStyles.length]!;
                      return (
                        <div
                          class={`rounded-xl border ${st.bg} ${st.border} p-5 hover:border-opacity-80 transition-colors shadow-sm dark:shadow-none`}
                        >
                          <h5 class={`font-semibold text-sm mb-2 ${st.title}`}>{card.title}</h5>
                          <p class="text-neutral-600 dark:text-zinc-400 text-sm leading-relaxed">{card.desc}</p>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    <div
      class="rounded-xl border border-app-line bg-app-panel/95 p-8 dark:border-dark-600 dark:bg-dark-700"
    >
      <h3 class="mb-8 text-center font-semibold text-neutral-900 dark:text-zinc-50">{ar.flowTitle}</h3>
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm">
        {
          ar.flow1.map((node, i) => {
            const isArrow = node === '→' || node === '←→';
            const colors = [
              'bg-orange-100 border-orange-200 text-orange-900 dark:bg-orange-900/55 dark:border-orange-700/45 dark:text-orange-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-orange-100 border-orange-200 text-orange-900 dark:bg-orange-900/55 dark:border-orange-700/45 dark:text-orange-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-red-100 border-red-200 text-red-900 dark:bg-red-900/55 dark:border-red-700/45 dark:text-red-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-amber-100 border-amber-200 text-amber-900 dark:bg-amber-900/55 dark:border-amber-700/45 dark:text-amber-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-stone-100 border-stone-200 text-stone-900 dark:bg-stone-900/55 dark:border-stone-700/45 dark:text-stone-200',
            ];
            const color = isArrow
              ? 'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500'
              : colors[i] ?? 'bg-neutral-200 border-neutral-300 text-neutral-800 dark:bg-dark-600 dark:border-dark-500 dark:text-zinc-300';
            return (
              <span class={`border px-3 py-1.5 rounded-lg font-medium ${color}`}>
                {node}
              </span>
            );
          })
        }
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm mt-3">
        {
          ar.flow2.map((node, i) => {
            const isArrow = node === '→' || node === '←→';
            const colors = [
              'bg-orange-100 border-orange-200 text-orange-900 dark:bg-orange-900/55 dark:border-orange-700/45 dark:text-orange-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-green-100 border-green-200 text-green-900 dark:bg-green-900/55 dark:border-green-700/45 dark:text-green-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-teal-100 border-teal-200 text-teal-900 dark:bg-teal-900/55 dark:border-teal-700/45 dark:text-teal-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-purple-100 border-purple-200 text-purple-900 dark:bg-purple-900/55 dark:border-purple-700/45 dark:text-purple-200',
              'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500',
              'bg-purple-100 border-purple-200 text-purple-900 dark:bg-purple-900/55 dark:border-purple-700/45 dark:text-purple-200',
            ];
            const color = isArrow
              ? 'text-neutral-400 bg-transparent border-transparent dark:text-zinc-500'
              : colors[i] ?? 'bg-neutral-200 border-neutral-300 text-neutral-800 dark:bg-dark-600 dark:border-dark-500 dark:text-zinc-300';
            return (
              <span class={`border px-3 py-1.5 rounded-lg font-medium ${color}`}>
                {node}
              </span>
            );
          })
        }
      </div>
    </div>

    {
      ar.versusClassic && (
        <div id="advantages" class="mt-12 max-w-4xl mx-auto scroll-mt-28 lg:scroll-mt-32">
          <div class="text-center mb-10 max-w-3xl mx-auto">
            <div
              class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50/90 px-4 py-1.5 dark:border-amber-800/50 dark:bg-amber-950/60"
            >
              <span class="text-sm font-medium text-amber-900 dark:text-amber-200">{ar.versusClassic.badge}</span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 dark:text-zinc-50 mb-5">
              {ar.versusClassic.titleA}
              <br />
              <span class="bg-gradient-to-r from-amber-500 to-orange-400 bg-clip-text text-transparent">
                {ar.versusClassic.titleB}
              </span>
            </h2>
            <p class="text-neutral-600 dark:text-zinc-400 text-lg max-w-2xl mx-auto">{ar.versusClassic.intro}</p>
          </div>
          <div
            class={`space-y-4 rounded-xl border bg-app-panel/95 p-5 dark:bg-dark-700 ${versusClassicStyle.border}`}
          >
            {ar.versusClassic.items.map((row) => (
              <div class="flex items-start gap-3">
                <div class={`shrink-0 mt-1 w-1.5 h-1.5 rounded-full ${versusClassicStyle.dot} opacity-60`} />
                <div>
                  <div class="text-sm font-medium text-neutral-900 dark:text-zinc-50">{row.aspect}</div>
                  <div class="text-neutral-500 dark:text-zinc-500 text-xs leading-relaxed">{row.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
