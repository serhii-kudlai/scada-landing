---
import type { Messages } from '../i18n/types';

interface Props {
  m: Messages;
}

const { m } = Astro.props;
const ar = m.architecture;

const layerColors = ['blue', 'cyan', 'orange', 'green', 'purple', 'slate'] as const;

const colorMap: Record<string, { header: string; dot: string; border: string }> = {
  blue:   { header: 'bg-blue-100 dark:bg-blue-900/50',   dot: 'bg-blue-500 dark:bg-blue-400',   border: 'border-blue-200 dark:border-blue-800/40' },
  cyan:   { header: 'bg-cyan-100 dark:bg-cyan-900/50',   dot: 'bg-cyan-500 dark:bg-cyan-400',   border: 'border-cyan-200 dark:border-cyan-800/40' },
  teal:   { header: 'bg-teal-100 dark:bg-teal-900/50',   dot: 'bg-teal-500 dark:bg-teal-400',   border: 'border-teal-200 dark:border-teal-800/40' },
  orange: { header: 'bg-orange-100 dark:bg-orange-900/50', dot: 'bg-orange-500 dark:bg-orange-400', border: 'border-orange-200 dark:border-orange-800/40' },
  green:  { header: 'bg-green-100 dark:bg-green-900/50',  dot: 'bg-green-500 dark:bg-green-400',  border: 'border-green-200 dark:border-green-800/40' },
  purple: { header: 'bg-purple-100 dark:bg-purple-900/50', dot: 'bg-purple-500 dark:bg-purple-400', border: 'border-purple-200 dark:border-purple-800/40' },
  slate:  { header: 'bg-slate-200 dark:bg-slate-700/50',  dot: 'bg-slate-500 dark:bg-slate-400',  border: 'border-slate-300 dark:border-slate-600/40' },
};

/** Accent per «Интерфейс системы» block: рамка и шапка как у слоёв архитектуры */
const systemInterfaceLayerAccents = ['blue', 'cyan', 'orange', 'purple'] as const;

/** Сетка мелких карточек — если у группы нет layout: layer */
const ifaceCardStyles = [
  { bg: 'bg-blue-50 dark:bg-blue-950/35', border: 'border-blue-200 dark:border-blue-800/45', title: 'text-blue-800 dark:text-blue-300' },
  { bg: 'bg-cyan-50 dark:bg-cyan-950/35', border: 'border-cyan-200 dark:border-cyan-800/45', title: 'text-cyan-800 dark:text-cyan-300' },
  { bg: 'bg-indigo-50 dark:bg-indigo-950/35', border: 'border-indigo-200 dark:border-indigo-800/45', title: 'text-indigo-800 dark:text-indigo-300' },
  { bg: 'bg-teal-50 dark:bg-teal-950/35', border: 'border-teal-200 dark:border-teal-800/45', title: 'text-teal-800 dark:text-teal-300' },
  { bg: 'bg-violet-50 dark:bg-violet-950/35', border: 'border-violet-200 dark:border-violet-800/45', title: 'text-violet-800 dark:text-violet-300' },
  { bg: 'bg-orange-50 dark:bg-orange-950/35', border: 'border-orange-200 dark:border-orange-800/45', title: 'text-orange-800 dark:text-orange-300' },
  { bg: 'bg-emerald-50 dark:bg-emerald-950/35', border: 'border-emerald-200 dark:border-emerald-800/45', title: 'text-emerald-800 dark:text-emerald-300' },
  { bg: 'bg-sky-50 dark:bg-sky-950/35', border: 'border-sky-200 dark:border-sky-800/45', title: 'text-sky-800 dark:text-sky-300' },
] as const;

const versusClassicStyle = colorMap.teal!;
---

<section id="architecture" class="py-24 lg:py-32 relative">
  <div class="absolute inset-0 bg-slate-100 dark:bg-dark-900"></div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_#bfdbfe_0%,_transparent_60%)] opacity-50 dark:bg-[radial-gradient(ellipse_at_bottom,_#172554_0%,_transparent_60%)] dark:opacity-40"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/90 px-4 py-1.5 mb-6 dark:border-blue-800/50 dark:bg-blue-950/60"
      >
        <span class="text-sm font-medium text-blue-700 dark:text-blue-400">{ar.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-5">
        {ar.h2a}<br />
        <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
          {ar.h2b}
        </span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">
        {ar.intro}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
      {
        ar.layers.map((layer, idx) => {
          const colorKey = layerColors[idx] ?? 'blue';
          const c = colorMap[colorKey]!;
          return (
            <div class={`overflow-hidden rounded-2xl border bg-white/90 dark:bg-dark-700/40 ${c.border}`}>
              <div class={`${c.header} px-5 py-3 flex items-center gap-2`}>
                <span class={`w-2 h-2 rounded-full ${c.dot}`} />
                <span class="text-sm font-semibold text-slate-900 dark:text-white">{layer.label}</span>
              </div>
              <div class="p-5 space-y-3">
                {layer.items.map((item) => (
                  <div class="flex items-start gap-3">
                    <div class={`shrink-0 mt-1 w-1.5 h-1.5 rounded-full ${c.dot} opacity-60`} />
                    <div>
                      <div class="text-sm font-medium text-slate-900 dark:text-white">{item.name}</div>
                      <div class="text-slate-500 text-xs">{item.desc}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>

    {
      ar.systemInterface && (
        <div id="system-interface" class="mb-16 scroll-mt-28 lg:scroll-mt-32">
          <div class="text-center mb-10 max-w-3xl mx-auto">
            <div
              class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/90 px-4 py-1.5 mb-6 dark:border-blue-800/50 dark:bg-blue-950/60"
            >
              <span class="text-sm font-medium text-blue-700 dark:text-blue-400">{ar.systemInterface.badge}</span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-5">
              {ar.systemInterface.titleA}
              <br />
              <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
                {ar.systemInterface.titleB}
              </span>
            </h2>
            <p class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">{ar.systemInterface.intro}</p>
          </div>
          <div class="space-y-12">
            {ar.systemInterface.groups.map((group, groupIndex) => {
              const isLayerList = group.layout === 'layer';
              if (isLayerList) {
                const accentKey =
                  systemInterfaceLayerAccents[
                    groupIndex % systemInterfaceLayerAccents.length
                  ]!;
                const c = colorMap[accentKey]!;
                return (
                  <div
                    class={`mx-auto max-w-4xl overflow-hidden rounded-2xl border bg-white/90 dark:bg-dark-700/40 ${c.border}`}
                  >
                    <div class={`${c.header} px-5 py-3 flex items-center gap-2`}>
                      <span class={`w-2 h-2 rounded-full ${c.dot}`} />
                      <span class="text-sm font-semibold text-slate-900 dark:text-white">{group.title}</span>
                    </div>
                    <div class="p-5 space-y-3">
                      {group.cards.map((card) => (
                        <div class="flex items-start gap-3">
                          <div class={`shrink-0 mt-1 w-1.5 h-1.5 rounded-full ${c.dot} opacity-60`} />
                          <div>
                            <div class="text-sm font-medium text-slate-900 dark:text-white">{card.title}</div>
                            <div class="text-slate-500 text-xs leading-relaxed">{card.desc}</div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              }

              const cols =
                group.cards.length === 1
                  ? 'grid max-w-2xl mx-auto grid-cols-1'
                  : 'grid sm:grid-cols-2 lg:grid-cols-3 gap-4';
              return (
                <div>
                  <h4 class="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-white">
                    <span class="w-1 h-6 rounded-full bg-gradient-to-b from-blue-500 to-cyan-500" />
                    {group.title}
                  </h4>
                  <div class={cols}>
                    {group.cards.map((card, ci) => {
                      const st = ifaceCardStyles[ci % ifaceCardStyles.length]!;
                      return (
                        <div
                          class={`rounded-2xl border ${st.bg} ${st.border} p-5 hover:border-opacity-80 transition-colors`}
                        >
                          <h5 class={`font-semibold text-sm mb-2 ${st.title}`}>{card.title}</h5>
                          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{card.desc}</p>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    <div
      class="rounded-2xl border border-slate-200 bg-white/90 p-8 dark:border-slate-700/40 dark:bg-dark-700/40"
    >
      <h3 class="mb-8 text-center font-semibold text-slate-900 dark:text-white">{ar.flowTitle}</h3>
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm">
        {
          ar.flow1.map((node, i) => {
            const isArrow = node === '→' || node === '←→';
            const colors = [
              'bg-orange-900/60 border-orange-700/50 text-orange-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-orange-900/60 border-orange-700/50 text-orange-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-red-900/60 border-red-700/50 text-red-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-cyan-900/60 border-cyan-700/50 text-cyan-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-blue-900/60 border-blue-700/50 text-blue-300',
            ];
            const color = isArrow
              ? 'text-slate-500 bg-transparent border-transparent'
              : colors[i] ?? 'bg-slate-800/60 border-slate-600/50 text-slate-300';
            return (
              <span class={`border px-3 py-1.5 rounded-lg font-medium ${color}`}>
                {node}
              </span>
            );
          })
        }
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm mt-3">
        {
          ar.flow2.map((node, i) => {
            const isArrow = node === '→' || node === '←→';
            const colors = [
              'bg-orange-900/60 border-orange-700/50 text-orange-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-green-900/60 border-green-700/50 text-green-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-cyan-900/60 border-cyan-700/50 text-cyan-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-purple-900/60 border-purple-700/50 text-purple-300',
              'text-slate-500 bg-transparent border-transparent',
              'bg-purple-900/60 border-purple-700/50 text-purple-300',
            ];
            const color = isArrow
              ? 'text-slate-500 bg-transparent border-transparent'
              : colors[i] ?? 'bg-slate-800/60 border-slate-600/50 text-slate-300';
            return (
              <span class={`border px-3 py-1.5 rounded-lg font-medium ${color}`}>
                {node}
              </span>
            );
          })
        }
      </div>
    </div>

    {
      ar.versusClassic && (
        <div id="advantages" class="mt-12 max-w-4xl mx-auto scroll-mt-28 lg:scroll-mt-32">
          <div class="text-center mb-10 max-w-3xl mx-auto">
            <div
              class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/90 px-4 py-1.5 dark:border-blue-800/50 dark:bg-blue-950/60"
            >
              <span class="text-sm font-medium text-blue-700 dark:text-blue-400">{ar.versusClassic.badge}</span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-5">
              {ar.versusClassic.titleA}
              <br />
              <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
                {ar.versusClassic.titleB}
              </span>
            </h2>
            <p class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">{ar.versusClassic.intro}</p>
          </div>
          <div
            class={`space-y-4 rounded-2xl border bg-white/90 p-5 dark:bg-dark-700/40 ${versusClassicStyle.border}`}
          >
            {ar.versusClassic.items.map((row) => (
              <div class="flex items-start gap-3">
                <div class={`shrink-0 mt-1 w-1.5 h-1.5 rounded-full ${versusClassicStyle.dot} opacity-60`} />
                <div>
                  <div class="text-sm font-medium text-slate-900 dark:text-white">{row.aspect}</div>
                  <div class="text-slate-500 text-xs leading-relaxed">{row.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
