---
import type { Locale } from '../i18n/types';
import type { Messages } from '../i18n/types';
import ObjectScadaLogo from './ObjectScadaLogo.astro';
import { anchorHref, homeHref } from '../i18n/utils';

interface Props {
  lang: Locale;
  m: Messages;
}

const { lang, m } = Astro.props;
const f = m.footer;

const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;

const userManualFiles: Record<string, string> = {
  en: 'USER_MANUAL_EN.pdf',
  ru: 'USER_MANUAL_RU.pdf',
  de: 'USER_MANUAL_DE.pdf',
  uk: 'USER_MANUAL_UK.pdf',
  es: 'USER_MANUAL_ES.pdf',
  fr: 'USER_MANUAL_FR.pdf',
  ar: 'USER_MANUAL_AR.pdf',
  zh: 'USER_MANUAL_ZH.pdf',
};

function getDocHref(link: { href: string | null; id?: string }): string {
  const id = (link as { id?: string }).id;
  if (id === 'user-manual') {
    const file = userManualFiles[lang] ?? 'USER_MANUAL_EN.pdf';
    return `${baseUrl}docs/${file}`;
  }
  if (id === 'api-reference') {
    return `${baseUrl}docs/API_REFERENCE.pdf`;
  }
  return link.href ?? '#';
}

function isPdfDocLink(link: { id?: string }): boolean {
  const id = (link as { id?: string }).id;
  return id === 'user-manual' || id === 'api-reference';
}

function isHiddenDocLink(link: { id?: string }): boolean {
  const id = (link as { id?: string }).id;
  return id === 'user-manual' || id === 'api-reference';
}

const tech = [
  'Django 4.2', 'React 18', 'TypeScript', 'Rust', 'PostgreSQL',
  'TimescaleDB', 'Redis', 'Docker', 'FastAPI', 'OPC UA',
];
---

<footer class="border-t border-line bg-sunken pt-16 pb-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href={homeHref(lang)} class="mb-4 inline-flex" aria-label="OBJECTSCADA">
          <ObjectScadaLogo size="footer" />
        </a>
        <p class="text-sm leading-relaxed text-muted">{f.tagline}</p>
      </div>

      <div>
        <h4 class="kicker mb-5">{f.columns.product}</h4>
        <ul class="space-y-3">
          {
            f.links.product.map((link) => (
              <li>
                <a href={anchorHref(lang, link.href)} class="text-sm text-muted transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="kicker mb-5">{f.columns.docs}</h4>
        <ul class="space-y-3">
          {
            f.links.docs.map((link) => {
              const openPdf = isPdfDocLink(link);
              return (
                <li class:list={[isHiddenDocLink(link) && 'hidden']}>
                  <a
                    href={getDocHref(link)}
                    target={openPdf ? '_blank' : undefined}
                    rel={openPdf ? 'noopener noreferrer' : undefined}
                    class="text-sm text-muted transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div>
        <h4 class="kicker mb-5">{f.columns.contact}</h4>
        <ul class="space-y-3">
          {
            f.links.contact.map((link) => (
              <li>
                <a href={anchorHref(lang, link.href)} class="text-sm text-muted transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 font-mono text-xs text-muted">info@scada.example.com</p>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-line pt-6 sm:flex-row">
      <p class="text-sm text-muted">&copy; {currentYear} OBJECTSCADA. {f.copyright}</p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-xs text-muted transition-colors hover:text-ink">{f.privacy}</a>
        <a href="#" class="text-xs text-muted transition-colors hover:text-ink">{f.terms}</a>
      </div>
    </div>
  </div>
</footer>
