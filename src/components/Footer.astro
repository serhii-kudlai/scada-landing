---
import type { Locale } from '../i18n/types';
import type { Messages } from '../i18n/types';
import ObjectScadaLogo from './ObjectScadaLogo.astro';
import { anchorHref, homeHref } from '../i18n/utils';

interface Props {
  lang: Locale;
  m: Messages;
}

const { lang, m } = Astro.props;
const f = m.footer;

const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;

const userManualFiles: Record<string, string> = {
  en: 'USER_MANUAL_EN.pdf',
  ru: 'USER_MANUAL_RU.pdf',
  de: 'USER_MANUAL_DE.pdf',
  uk: 'USER_MANUAL_UK.pdf',
  es: 'USER_MANUAL_ES.pdf',
  fr: 'USER_MANUAL_FR.pdf',
  ar: 'USER_MANUAL_AR.pdf',
  zh: 'USER_MANUAL_ZH.pdf',
};

function getDocHref(link: { href: string | null; id?: string }): string {
  if ((link as { id?: string }).id === 'user-manual') {
    const file = userManualFiles[lang] ?? 'USER_MANUAL_EN.pdf';
    return `${baseUrl}docs/${file}`;
  }
  return link.href ?? '#';
}

const tech = [
  'Django 4.2', 'React 18', 'TypeScript', 'Rust', 'PostgreSQL',
  'TimescaleDB', 'Redis', 'Docker', 'FastAPI', 'OPC UA',
];
---

<footer
  class="border-t border-app-line bg-app-canvas pt-16 pb-8 dark:border-dark-600 dark:bg-dark-900"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <div class="lg:col-span-1">
        <a href={homeHref(lang)} class="mb-4 inline-flex transition-opacity hover:opacity-90">
          <ObjectScadaLogo size="footer" />
        </a>
        <p class="mb-5 text-sm leading-relaxed text-neutral-600 dark:text-zinc-500">
          {f.tagline}
        </p>
        <div class="flex items-center gap-3">
          <div
            class="flex items-center gap-1.5 rounded-full border border-green-200 bg-green-50 px-3 py-1 dark:border-green-800/40 dark:bg-green-900/30"
          >
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 dark:bg-green-400"></span>
            <span class="text-xs font-medium text-green-700 dark:text-green-400">{f.status}</span>
          </div>
        </div>
      </div>

      <div>
        <h4 class="mb-5 text-sm font-semibold text-neutral-900 dark:text-zinc-50">{f.columns.product}</h4>
        <ul class="space-y-3">
          {
            f.links.product.map((link) => (
              <li>
                <a
                  href={anchorHref(lang, link.href)}
                  class="text-sm text-neutral-600 transition-colors hover:text-neutral-900 dark:text-zinc-500 dark:hover:text-zinc-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-5 text-sm font-semibold text-neutral-900 dark:text-zinc-50">{f.columns.docs}</h4>
        <ul class="space-y-3">
          {
            f.links.docs.map((link) => {
              const isManual = (link as { id?: string }).id === 'user-manual';
              return (
                <li>
                  <a
                    href={getDocHref(link)}
                    target={isManual ? '_blank' : undefined}
                    rel={isManual ? 'noopener noreferrer' : undefined}
                    class="text-sm text-neutral-600 transition-colors hover:text-neutral-900 dark:text-zinc-500 dark:hover:text-zinc-300"
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-5 text-sm font-semibold text-neutral-900 dark:text-zinc-50">{f.columns.contact}</h4>
        <ul class="space-y-3">
          {
            f.links.contact.map((link) => (
              <li>
                <a
                  href={anchorHref(lang, link.href)}
                  class="text-sm text-neutral-600 transition-colors hover:text-neutral-900 dark:text-zinc-500 dark:hover:text-zinc-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 space-y-2">
          <div class="flex items-center gap-2 text-xs text-neutral-600 dark:text-zinc-500">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>info@scada.example.com</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-8 border-t border-app-line pt-8 dark:border-dark-600">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 justify-center">
        {
          tech.map((t) => (
            <span class="text-xs font-mono text-neutral-500 dark:text-zinc-600">{t}</span>
          ))
        }
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-app-line pt-6 dark:border-dark-600 sm:flex-row"
    >
      <p class="text-sm text-neutral-600 dark:text-zinc-500">
        &copy; {currentYear} OBJECTSCADA. {f.copyright}
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-xs text-neutral-500 transition-colors hover:text-neutral-800 dark:text-zinc-600 dark:hover:text-zinc-400">
          {f.privacy}
        </a>
        <a href="#" class="text-xs text-neutral-500 transition-colors hover:text-neutral-800 dark:text-zinc-600 dark:hover:text-zinc-400">
          {f.terms}
        </a>
      </div>
    </div>
  </div>
</footer>
