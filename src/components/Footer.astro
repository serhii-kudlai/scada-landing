---
import type { Locale } from '../i18n/types';
import type { Messages } from '../i18n/types';
import { anchorHref, homeHref } from '../i18n/utils';

interface Props {
  lang: Locale;
  m: Messages;
}

const { lang, m } = Astro.props;
const f = m.footer;

const currentYear = new Date().getFullYear();

const tech = [
  'Django 4.2', 'React 18', 'TypeScript', 'Rust', 'PostgreSQL',
  'TimescaleDB', 'Redis', 'Docker', 'FastAPI', 'OPC UA',
];
---

<footer class="bg-dark-900 border-t border-slate-800/60 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <div class="lg:col-span-1">
        <a href={homeHref(lang)} class="flex items-center gap-3 mb-4 group">
          <div
            class="w-9 h-9 rounded-lg bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow-lg shadow-blue-500/30"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <span class="text-white font-bold text-lg">
            SCADA <span class="text-blue-400">System</span>
          </span>
        </a>
        <p class="text-slate-500 text-sm leading-relaxed mb-5">
          {f.tagline}
        </p>
        <div class="flex items-center gap-3">
          <div
            class="flex items-center gap-1.5 bg-green-900/30 border border-green-800/40 rounded-full px-3 py-1"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
            <span class="text-green-400 text-xs font-medium">{f.status}</span>
          </div>
        </div>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm mb-5">{f.columns.product}</h4>
        <ul class="space-y-3">
          {
            f.links.product.map((link) => (
              <li>
                <a
                  href={anchorHref(lang, link.href)}
                  class="text-slate-500 hover:text-slate-300 text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm mb-5">{f.columns.docs}</h4>
        <ul class="space-y-3">
          {
            f.links.docs.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-500 hover:text-slate-300 text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm mb-5">{f.columns.contact}</h4>
        <ul class="space-y-3">
          {
            f.links.contact.map((link) => (
              <li>
                <a
                  href={anchorHref(lang, link.href)}
                  class="text-slate-500 hover:text-slate-300 text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 space-y-2">
          <div class="flex items-center gap-2 text-slate-600 text-xs">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>info@scada.example.com</span>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-800/60 pt-8 mb-8">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 justify-center">
        {
          tech.map((t) => (
            <span class="text-slate-600 text-xs font-mono">{t}</span>
          ))
        }
      </div>
    </div>

    <div
      class="border-t border-slate-800/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-slate-600 text-sm">
        &copy; {currentYear} SCADA System. {f.copyright}
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-slate-600 hover:text-slate-400 text-xs transition-colors">
          {f.privacy}
        </a>
        <a href="#" class="text-slate-600 hover:text-slate-400 text-xs transition-colors">
          {f.terms}
        </a>
      </div>
    </div>
  </div>
</footer>
