---
import type { Locale, Messages } from '../i18n/types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ObjectScadaLogo from './ObjectScadaLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { anchorHref, homeHref } from '../i18n/utils';

interface Props {
  lang: Locale;
  m: Messages;
}

const { lang, m } = Astro.props;

const navLinks = [
  { label: m.header.nav.features, id: 'features' },
  { label: m.header.nav.interface, id: 'interface' },
  { label: m.header.nav.protocols, id: 'protocols' },
  { label: m.header.nav.deployment, id: 'deployment' },
  { label: m.header.nav.contacts, id: 'contact' },
];
---

<header id="header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-200">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href={homeHref(lang)} class="shrink-0" aria-label="OBJECTSCADA">
      <ObjectScadaLogo size="header" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {
        navLinks.map((link) => (
          <a href={anchorHref(lang, `#${link.id}`)} class="text-sm font-medium text-muted transition-colors hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <LanguageSwitcher lang={lang} m={m} id="lang-header" />
      <ThemeToggle m={m} />
      <a
        href={anchorHref(lang, '#contact')}
        class="hidden h-9 items-center rounded bg-ink px-4 text-sm font-semibold text-bg transition-opacity hover:opacity-85 sm:inline-flex"
      >
        {m.header.requestDemo}
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded border border-line bg-paper text-ink lg:hidden"
        aria-label={m.header.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-4 py-2 sm:px-6" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a
            href={anchorHref(lang, `#${link.id}`)}
            class="mobile-nav-link border-b border-line py-3 text-sm font-medium text-ink last:border-0"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('header')!;
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header.classList.toggle('bg-bg', scrolled);
    header.classList.toggle('border-line', scrolled);
    header.classList.toggle('border-transparent', !scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    if (open) header.classList.add('bg-bg');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) =>
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
