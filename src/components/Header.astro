---
import type { Locale } from '../i18n/types';
import type { Messages } from '../i18n/types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { anchorHref, homeHref } from '../i18n/utils';

interface Props {
  lang: Locale;
  m: Messages;
}

const { lang, m } = Astro.props;

const navLinks = [
  { label: m.header.nav.features, id: 'features' as const },
  { label: m.header.nav.integrations, id: 'integrations' as const },
  { label: m.header.nav.ai, id: 'ai' as const },
  { label: m.header.nav.architecture, id: 'architecture' as const },
  { label: m.header.nav.systemInterface, id: 'system-interface' as const },
  { label: m.header.nav.advantages, id: 'advantages' as const },
  { label: m.header.nav.projects, id: 'projects' as const },
  { label: m.header.nav.contacts, id: 'contact' as const },
];
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10">
    <div
      class="flex h-16 lg:h-20 w-full items-center justify-between gap-4 xl:grid xl:items-center xl:gap-x-4 xl:[grid-template-columns:auto_minmax(0,1fr)_auto] 2xl:gap-x-6"
    >
      <a href={homeHref(lang)} class="flex items-center gap-3 group min-w-0 xl:justify-self-start shrink-0">
        <div
          class="w-9 h-9 rounded-lg bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow-lg shadow-blue-500/30"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
              stroke="white"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <span
          class="font-bold text-lg tracking-tight text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400"
        >
          SCADA <span class="text-blue-400">System</span>
        </span>
      </a>

      <div class="hidden xl:block xl:min-w-0 xl:w-full xl:justify-self-stretch relative">
        <!-- Right fade to signal scrollability if needed -->
        <div class="absolute right-0 top-0 bottom-0 w-6 bg-gradient-to-l from-white/80 dark:from-dark-800/80 to-transparent pointer-events-none z-10"></div>
        <nav
          id="header-nav"
          class="flex min-w-0 w-full items-center justify-start gap-x-1 xl:gap-x-1.5 2xl:gap-x-3 px-1 overflow-x-auto overscroll-x-contain touch-pan-x [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden select-none"
          aria-label="Main"
        >
          {
            navLinks.map((link) => (
              <a
                href={anchorHref(lang, `#${link.id}`)}
                class="text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white text-[11px] 2xl:text-[13px] font-medium transition-colors duration-200 relative group whitespace-nowrap shrink-0 px-0.5"
              >
                {link.label}
                <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-500 group-hover:w-full transition-all duration-300" />
              </a>
            ))
          }
        </nav>
      </div>

      <div
        class="flex items-center gap-1.5 sm:gap-2 2xl:gap-3 shrink-0 pl-2 xl:pl-3 2xl:pl-5 xl:border-l xl:border-slate-300/80 dark:xl:border-slate-800/50"
      >
        <div class="flex">
          <LanguageSwitcher lang={lang} m={m} id="lang-header" />
        </div>
        <ThemeToggle m={m} />
        <a
          href={anchorHref(lang, '#contact')}
          class="hidden sm:inline-flex bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-all duration-200 shadow-lg shadow-blue-600/25 hover:shadow-blue-500/40 dark:shadow-blue-600/30 whitespace-nowrap"
        >
          {m.header.requestDemo}
        </a>
        <button
          id="mobile-menu-btn"
          class="xl:hidden text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white p-2"
          aria-label={m.header.openMenu}
        >
          <svg
            id="icon-menu"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            id="icon-close"
            class="hidden"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden xl:hidden border-t border-slate-200 bg-white/95 backdrop-blur-md dark:border-slate-800 dark:bg-dark-800/95"
  >
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-3">
      <div class="flex justify-center pb-2">
        <LanguageSwitcher lang={lang} m={m} id="lang-mobile" />
      </div>
      {
        navLinks.map((link) => (
          <a
            href={anchorHref(lang, `#${link.id}`)}
            class="mobile-nav-link text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white py-2 text-sm font-medium border-b border-slate-200 dark:border-slate-800/60 last:border-0"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('header')!;
  const mobileMenuBtn = document.getElementById('mobile-menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header.classList.add(
        'bg-white/95',
        'dark:bg-dark-800/95',
        'backdrop-blur-md',
        'border-b',
        'border-slate-200/90',
        'dark:border-slate-800/60',
        'shadow-xl'
      );
    } else {
      header.classList.remove(
        'bg-white/95',
        'dark:bg-dark-800/95',
        'backdrop-blur-md',
        'border-b',
        'border-slate-200/90',
        'dark:border-slate-800/60',
        'shadow-xl'
      );
    }
  });

  mobileMenuBtn.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    iconMenu.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });

  /* Drag-to-scroll on desktop nav */
  const nav = document.getElementById('header-nav');
  if (nav) {
    let isDragging = false;
    let startX = 0;
    let scrollLeft = 0;
    let dragMoved = false;

    nav.addEventListener('mousedown', (e) => {
      isDragging = true;
      dragMoved = false;
      startX = e.pageX - nav.offsetLeft;
      scrollLeft = nav.scrollLeft;
      nav.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const x = e.pageX - nav.offsetLeft;
      const delta = x - startX;
      if (Math.abs(delta) > 3) dragMoved = true;
      nav.scrollLeft = scrollLeft - delta;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
      nav.style.cursor = '';
    });

    /* Prevent link navigation when drag occurred */
    nav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (dragMoved) {
          e.preventDefault();
          dragMoved = false;
        }
      });
    });
  }
</script>
